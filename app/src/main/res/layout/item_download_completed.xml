<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCompletedItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/frameCompletedThumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCompletedThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

        <ImageView
            android:id="@+id/icCompletedBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCompletedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="World leaders reach landmark climate agreement"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnMoreCompleted"
        app:layout_constraintStart_toEndOf="@id/frameCompletedThumb"
        app:layout_constraintTop_toTopOf="@id/frameCompletedThumb" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/btnMoreCompleted"
        app:layout_constraintStart_toEndOf="@id/frameCompletedThumb"
        app:layout_constraintTop_toBottomOf="@id/tvCompletedTitle">

        <TextView
            android:id="@+id/tvCompletedTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_circle"
            android:backgroundTint="@color/download_badge_pdf_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="PDF"
            android:textColor="@color/download_badge_pdf_text"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompletedSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="• 9.6 MB"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCompletedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="• Today, 10:42 AM"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnMoreCompleted"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="2dp"
        android:src="@drawable/ic_more_horiz"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dividerCompleted"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

