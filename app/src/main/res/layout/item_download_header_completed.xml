<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvCompletedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/downloads_completed_section"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badgeCompletedCount"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="#E2E8F0"
        app:cardCornerRadius="11dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/tvCompletedTitle"
        app:layout_constraintStart_toEndOf="@id/tvCompletedTitle"
        app:layout_constraintTop_toTopOf="@id/tvCompletedTitle">

        <TextView
            android:id="@+id/tvCompletedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            tools:text="0"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSortCompleted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/downloads_sort_newest"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
